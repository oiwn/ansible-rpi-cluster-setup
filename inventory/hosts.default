---
all:
  children:
    main:
      hosts:
         raspb1s.local:
           ansible_user: your_user
           # ethtool -P eth0
           eth0_mac: "xx:xx:xx:xx:xx:xx"
           # ethtool -P wlan0
           wlan0_mac: "xx:xx:xx:xx:xx:xx"
           wifi_ip: "0.0.0.0"
           cluster_ip: "10.0.0.1"
           # home router / ISP DNS used by dnsmasq for forwarding
           upstream_dns: "0.0.0.0"
           # serial: grep Serial /proc/cpuinfo | cut -d ' ' -f 2 | cut -c 9-16
           serial: "xxxxxxxx"

    workers:
      hosts:
        raspb2.local:
          ansible_user: your_user
          mac_address: "xx:xx:xx:xx:xx:xx"
          ip: "10.0.0.2"
          serial: "xxxxxxxx"
        raspb3.local:
          ansible_user: your_user
          mac_address: "xx:xx:xx:xx:xx:xx"
          ip: "10.0.0.3"
          serial: "xxxxxxxx"

    fallback:
      hosts:
        raspb1f.local:
          purpose: "fallback"
          ip: "0.0.0.0"

    cluster:
      children:
        main:
        workers:
